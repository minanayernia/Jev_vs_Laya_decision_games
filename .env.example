# --- Jev (TypeSafe AI) -------------------------------------------------------
# Get a key at https://console.typesafe.ai/settings/keys
# The official SDK reads this exact variable name.
TYPESAFE_API_KEY=
# Pin a model version for reproducible experiments (full id, e.g. jev-1.13.0).
# "jev-latest" is a moving alias.
JEV_MODEL=jev-latest

# --- Laya (Convai Innovations, runs locally) ---------------------------------
# No API key needed: weights download from Hugging Face on first use.
LAYA_REPO=convaiinnovations/laya
# Empty = English base checkpoint (repo root). Alternatives: multilingual, typed-decisions
LAYA_SUBFOLDER=
# cpu gives bit-identical answers; cuda/mps may differ in the 4th decimal.
LAYA_DEVICE=cpu
